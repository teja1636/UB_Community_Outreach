# Supabase — from https://supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-side secret used to hash phone numbers/emails (never commit, never expose)
HASH_PEPPER=change_me_to_a_long_random_string

# Service-role key (Settings → API → service_role). SERVER-ONLY — used to create
# user rows with a server-side phone hash and to check the blocked list.
# Never expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# App
NEXT_PUBLIC_APP_NAME=UB Community
NEXT_PUBLIC_APP_URL=http://localhost:3000
